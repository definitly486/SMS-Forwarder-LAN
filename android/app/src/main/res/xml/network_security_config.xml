<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Server URL is configurable and may use a private IP address.
        Android domain-config cannot express RFC1918 CIDR ranges, so
        permitting cleartext in the base config is required for LAN HTTP.
        Prefer HTTPS whenever the server supports it.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
