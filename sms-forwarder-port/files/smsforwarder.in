#!/bin/sh

# PROVIDE: smsforwarder
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="smsforwarder"
rcvar="${name}_enable"

load_rc_config $name

: ${smsforwarder_enable:="NO"}
: ${smsforwarder_user:="www"}
: ${smsforwarder_group:="www"}
: ${smsforwarder_dir:="/usr/local/sms-forwarder"}
: ${smsforwarder_python:="/usr/local/bin/python3.12"}

piddir="/var/run/smsforwarder"
pidfile="${piddir}/smsforwarder.pid"

command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${smsforwarder_user} -c ${smsforwarder_dir} ${smsforwarder_python} ${smsforwarder_dir}/server.py"

start_precmd="smsforwarder_prestart"
stop_postcmd="smsforwarder_poststop"

smsforwarder_prestart()
{
    if [ ! -d "${smsforwarder_dir}" ]; then
        echo "Directory ${smsforwarder_dir} does not exist"
        return 1
    fi
    if [ ! -f "${smsforwarder_dir}/server.py" ]; then
        echo "server.py not found"
        return 1
    fi
    if [ ! -f "${smsforwarder_dir}/config.json" ]; then
        echo "config.json not found"
        return 1
    fi

    # Каталог для pid-файла с правами www
    install -d -o ${smsforwarder_user} -g ${smsforwarder_group} -m 755 ${piddir}
}

smsforwarder_poststop()
{
    # Убираем pid-файл после остановки
    rm -f ${pidfile}
}

run_rc_command "$1"